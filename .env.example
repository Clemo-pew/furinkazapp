# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Supabase → Project Settings → API). Su Vercel inseriscili in Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chiave segreta (secret / service_role): serve per creare gli accessi degli atleti.
# Solo lato server: NON aggiungere il prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
